<?xml version="1.0" encoding="utf-8"?>
<!-- Neutral glass pill. The three header pills on Home get a tinted copy in code (MainActivity.tintGlass). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/theme_focus" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/theme_pill_fill" />
            <stroke android:width="1dp" android:color="@color/theme_hairline" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</selector>
