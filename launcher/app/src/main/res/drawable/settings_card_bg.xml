<?xml version="1.0" encoding="utf-8"?>
<!-- A section card: dark glass with a hairline edge, the same recipe as the home screen's cards (Glass.cardFill, no ambient colour). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#99000000" />
    <stroke android:width="1dp" android:color="@color/theme_hairline" />
    <corners android:radius="20dp" />
</shape>
