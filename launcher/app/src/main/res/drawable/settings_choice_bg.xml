<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#40F2EEE6" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="@color/theme_focus" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#3357D294" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="@color/theme_green" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/theme_surface_200" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
