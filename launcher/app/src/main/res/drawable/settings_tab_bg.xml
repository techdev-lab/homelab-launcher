<?xml version="1.0" encoding="utf-8"?>
<!-- Glass tab (a chip with pill corners; selected = the section showing). Focus is the home screen's highlight (GlassView): a light sheen and a bright rim. The chosen value is a
     filled base with an accent edge, and keeps its base under the ring while it has focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#4D57D294" />
                    <corners android:radius="21dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#3DFFFFFF" android:endColor="#12FFFFFF" />
                    <stroke android:width="2dp" android:color="#E6FFFFFF" />
                    <corners android:radius="21dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#3DFFFFFF" android:endColor="#12FFFFFF" />
            <stroke android:width="2dp" android:color="#E6FFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#3357D294" />
            <stroke android:width="2dp" android:color="@color/theme_green" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/theme_pill_fill" />
            <stroke android:width="1dp" android:color="@color/theme_hairline" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</selector>
